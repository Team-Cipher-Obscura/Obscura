{
  "manifest_version": 3,
  "name": "Obscura",
  "version": "1.0.0",
  "description": "Privacy-preserving browser agent",

  "permissions": [
    "tabs",
    "activeTab",
    "downloads",
    "storage"
  ],

  "host_permissions": [
    "http://localhost:8000/*",
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "p2/dom/stableIds.js",
        "p2/dom/extractElements.js",
        "dist/p2-vision.js",
        "p2/fusion/domVisionFusion.js",
        "content.bundle.js"
      ]
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "assets/obscura-logo.png",
        "p2/vision/ort/*",
        "p2/vision/yolo26n.onnx",
        "models/blazeface/*",
        "models/tessdata/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}